{
  "name": "dsh-cosplay",
  "version": "0.5.1",
  "description": "Cosplay mode for DeepSeek Harness: a global switch turns the agent into any character you define, with a settings UI for role configuration and management.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZelinW1/dsh-cosplay.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/store.js && node --check src/index.js && node --check src/client.js && node --check src/skill.js",
    "test": "node test/host-stub.test.mjs",
    "verify:client": "node test/tools/settings-check.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cosplay",
    "roleplay",
    "persona",
    "cordis"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2"
  }
}
